@model IEnumerable<Adopcion>

<h2>Lista de Adopciones</h2>

<table class="table">
    <thead>
        <tr>
            <th>Mascota</th>
            <th>Adoptante</th>
            <th>Fecha</th>
            <th>Estado</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var adopcion in Model)
        {
            <tr>
                <td>@adopcion.Mascota?.Nombre</td>
                <td>@adopcion.Adoptante?.Nombre</td>
                <td>@adopcion.FechaAdopcion.ToShortDateString()</td>
                <td>@(adopcion.Mascota?.EstaAdoptada == true ? "Adoptada" : "Disponible")</td>
            </tr>
        }
    </tbody>
</table>
